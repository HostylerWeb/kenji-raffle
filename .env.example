# =============================================================================
# Raffle Platform — multi-tenant environment
# Copy: cp .env.example .env
# Architecture: platform DB + one tenant DB per operator website.
# See docs/PROJECT_PLAN_2.md §4 and §9.
# =============================================================================

# --- Platform database (registry — operators, domains, rollups) ---
PLATFORM_DATABASE_URL="postgresql://kenji_platform:kenji_platform@localhost:5437/kenji_platform?schema=public"

# Postgres superuser for provisioning tenant databases (dev only — restrict in production)
DATABASE_ADMIN_URL="postgresql://kenji_platform:kenji_platform@localhost:5437/postgres?schema=public"

# Tenant DB naming: kenji_tenant_{slug} on same cluster (dev)
TENANT_DATABASE_HOST="localhost"
TENANT_DATABASE_PORT=5437
TENANT_DATABASE_NAME_PREFIX="kenji_tenant_"

# --- Redis (raffle platform) ---
REDIS_URL="redis://localhost:6383"

# --- MinIO / S3 (prefix: tenants/{operator_id}/) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="kenji-raffle"
MINIO_USE_SSL=false
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=uploads

# --- API ---
API_PORT=4002
NODE_ENV=development
API_PUBLIC_URL="http://localhost:4002"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Security (required in production — see docs/SECURITY_AUDIT.md)
# Comma-separated origins for CORS with credentials, e.g.:
# CORS_ALLOWED_ORIGINS="https://demo.force42.com,https://platform.force42.com,https://*.force42.com,https://pay.force42.com"
CORS_ALLOWED_ORIGINS=
CART_SESSION_SECRET=
AUTH_RATE_LIMIT_PER_MINUTE=20
TENANT_RATE_LIMIT_PER_MINUTE=300
SWAGGER_ENABLED=false

# Encrypt tenant database passwords and GRA keys at rest
CREDENTIALS_ENCRYPTION_KEY="change-me-32-byte-encryption-key-min"

# --- Platform console (platform staff — all tenants) ---
PLATFORM_WEB_PORT=3003
NEXT_PUBLIC_PLATFORM_URL="http://platform.kenji-raffle.local:3003"
# Local dev: same-origin proxy via Next.js (/platform-api → :4002) avoids CORS on *.kenji-raffle.local
NEXT_PUBLIC_PLATFORM_API_URL="/platform-api"
# Production build: NEXT_PUBLIC_PLATFORM_API_URL="https://api.force42.com"

# --- Tenant web (hostname → tenant DB) ---
WEB_PORT=3002
NEXT_PUBLIC_API_URL="http://localhost:4002"
NEXT_PUBLIC_PLATFORM_HOSTNAME="platform.kenji-raffle.local"
NEXT_PUBLIC_TENANT_BASE_DOMAIN="force42.com"
CUSTOM_DOMAIN_CNAME_TARGET="customers.force42.com"

# --- Harambe Payment Gateway ---
HARAMBE_PAYMENT_MODE="mock"
HARAMBE_PAYMENT_DISPLAY_NAME="Harambe Payment Gateway"
HARAMBE_CALLBACK_SECRET=dev-callback-secret
# Live checkout redirect — payment gateway (NOT GRA ingest :4001)
# Production VPS:
# HARAMBE_PAYMENT_MODE=live
# HARAMBE_GATEWAY_URL=https://pay.force42.com/v1/pay
# GATEWAY_DEV_MOCK=false
# Dev mock (raffle API): http://localhost:4002/v1/payments/dev-mock-gateway/pay
# HARAMBE_GATEWAY_URL=http://localhost:4002/v1/payments/dev-mock-gateway/pay
# GATEWAY_DEV_MOCK=true
# DEFAULT_GATEWAY_FEE_RATE=0.025

# --- Cloudflare (optional — Custom Hostnames API deferred; operator CNAME model) ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# When operator verifies custom domain, add hostname to CORS_ALLOWED_ORIGINS on VPS.

# --- Defaults (per-operator overrides in platform operator_settings) ---
DEFAULT_TAX_RATE=0.30
# Dev only — must be false/unset in production
PLAYER_AUTO_VERIFY_EMAIL=true

# --- GRA ingest base URL (per-operator keys in platform DB) ---
GRA_INGEST_URL="http://localhost:4001/v1"
# Production (VPS): GRA_INGEST_URL="https://ingest.force42.com/v1"

# --- Kenji ↔ GRA platform integration (operator onboarding) ---
# Shared HMAC secret with kenji-government (console API)
PLATFORM_GRA_INTEGRATION_SECRET="change-me-platform-gra-integration-secret"
# Kenji outbound: GRA integrations API base (staff console host)
GRA_INTEGRATIONS_URL="http://localhost:4000/integrations/v1"
# Production (via console Apache /api proxy):
# GRA_INTEGRATIONS_URL="https://console.force42.com/api/integrations/v1"
# Kenji inbound callback when GRA approves (production: https://api.force42.com/v1/platform/integrations/gra/credentials)
KENJI_PLATFORM_CALLBACK_URL="http://localhost:4002/v1/platform/integrations/gra/credentials"

# --- GRA platform relay (worker only — API enqueues, worker POSTs) ---
# GRA_RELAY_BATCH_SIZE=50
# GRA_RELAY_MAX_PER_MINUTE=50
# GRA_RELAY_OPERATOR_CONCURRENCY=3

# --- Cart ---
CART_RESERVATION_TTL_MINUTES=15
CHECKOUT_PENDING_TTL_MINUTES=60

# --- Custom domains (production CNAME target for operator DNS) ---
# CUSTOM_DOMAIN_CNAME_TARGET="customers.kenji-raffle.co.ke"

# --- Email (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Production scaling ---
# PGBOUNCER_URL=
# MAX_TENANT_DB_CONNECTIONS=10

# --- Production example (VPS) ---
# NODE_ENV=production
# API_PUBLIC_URL=https://api.force42.com
# CORS_ALLOWED_ORIGINS=https://demo.force42.com
# HARAMBE_PAYMENT_MODE=live
# PLAYER_AUTO_VERIFY_EMAIL=false
# SWAGGER_ENABLED=false
# GATEWAY_DEV_MOCK=false
